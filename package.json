{
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "devDependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/noto-serif-sc": "^5.3.0",
    "@iconify-json/mdi": "^1.2.3",
    "vitepress": "^2.0.0-alpha.20"
  },
  "scripts": {
    "docs:dev": "vitepress dev",
    "docs:build": "vitepress build",
    "docs:preview": "vitepress preview",
    "example:dev": "vitepress dev examples/native-demo --port 5175",
    "example:build": "vitepress build examples/native-demo",
    "example:preview": "vitepress preview examples/native-demo --port 4174",
    "check:layers": "node scripts/check-theme-layers.mjs",
    "check:isolation": "node scripts/check-example-isolation.mjs",
    "check:rendered": "node scripts/check-rendered-parity.mjs",
    "baseline:make": "bash scripts/make-baseline.sh",
    "verify": "npm run check:layers && npm run docs:build && npm run check:isolation",
    "verify:rendered": "npm run baseline:make && npm run docs:build && npm run check:rendered",
    "typecheck": "tsc --noEmit"
  }
}
