{
  // 只给编辑器用的类型配置：noEmit，不产出、不参与构建。
  //
  // 这里刻意没有 include 整个仓库：`.vitepress/config.mts` 与 `.vitepress/rss.ts`
  // 都用了 `node:` 内置模块，而项目没装 `@types/node`（依赖清单只留两项是刻意的），
  // 把它们纳进来会立刻多出一批「找不到模块 node:fs/promises」的新报错。
  // 哪天要覆盖这两个文件，先装 @types/node，再把 '.vitepress/**/*' 加进 include。
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": [
    // 主题：index.ts 与 cursor.ts
    ".vitepress/theme/**/*.ts",
    // 构建期数据加载器
    "pages/**/*.ts",
    "posts/**/*.ts"
  ]
}
