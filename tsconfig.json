{
  // 只给编辑器用的类型配置：noEmit，不产出、不参与构建。
  //
  // 主题（vitepress-theme-fluxixix）已经拆到独立仓库、以依赖形式装在 node_modules 下，
  // 不在本仓库的 include 里：它的类型随包发布（client.d.ts / site.d.ts / rss.d.ts），
  // 编辑器读包里的声明就够了。
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": [
    // 站点主题入口
    ".vitepress/theme/**/*.ts",
    // 构建期数据加载器
    "pages/**/*.ts",
    "posts/**/*.ts"
  ]
}
